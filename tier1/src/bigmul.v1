// Multiply two non-negative decimal numbers of up to 40 digits each.
// Digits are kept least significant first; the product has at most 80 digits.
array a[48];
array b[48];
array p[100];
var na;
var nb;

// Read one line of digits into a (which = 0) or b (which = 1); return its length.
func readnum(which) {
    var c;
    var n;
    var i;
    var t;
    n = 0;
    c = getc();
    while (c >= 48) {
        if (which == 0) { a[n] = c - 48; } else { b[n] = c - 48; }
        n = n + 1;
        c = getc();
    }
    // reverse in place so index 0 is the least significant digit
    i = 0;
    while (i < n - 1 - i) {
        if (which == 0) {
            t = a[i]; a[i] = a[n - 1 - i]; a[n - 1 - i] = t;
        } else {
            t = b[i]; b[i] = b[n - 1 - i]; b[n - 1 - i] = t;
        }
        i = i + 1;
    }
    return n;
}

func main() {
    var i;
    var j;
    var k;
    var carry;
    var v;
    var q;
    na = readnum(0);
    nb = readnum(1);
    i = 0;
    while (i < na) {
        j = 0;
        while (j < nb) {
            p[i + j] = p[i + j] + a[i] * b[j];
            j = j + 1;
        }
        i = i + 1;
    }
    // carries: no division, so take tens off by repeated subtraction (each cell < 4000)
    k = 0;
    carry = 0;
    while (k < na + nb + 1) {
        v = p[k] + carry;
        q = 0;
        while (v >= 1000) { v = v - 1000; q = q + 100; }
        while (v >= 100) { v = v - 100; q = q + 10; }
        while (v >= 10) { v = v - 10; q = q + 1; }
        p[k] = v;
        carry = q;
        k = k + 1;
    }
    i = 0;
    k = na + nb + 1;
    while (k > 0) {
        if (p[k] != 0) {
            i = k;
            k = 0;
        } else {
            k = k - 1;
        }
    }
    // i is the highest non-zero index (0 when the product is 0)
    while (i >= 0) {
        putc(48 + p[i]);
        i = i - 1;
    }
    putc(10);
}
