array pw[10];
func pd(n) {
  var m; var i; var d; var s;
  if (n < 0) { putc(45); m = n; } else { m = 0 - n; }
  pw[0] = 1;
  i = 1;
  while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
  s = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (m <= 0 - pw[i]) { m = m + pw[i]; d = d + 1; }
    if (d != 0) { s = 1; }
    if (i == 0) { s = 1; }
    if (s) { putc(48 + d); }
    i = i - 1;
  }
  putc(10);
}
array a[10];
func find(v) {
  var i;
  i = 0;
  while (i < 10) {
    if (a[i] == v) { return i; }
    i = i + 1;
  }
  return -1;
}
func firstsq(lim) {
  var i;
  i = 1;
  while (1) {
    if (i * i > lim) { return i; }
    i = i + 1;
  }
  return 0;
}
func nested(t) {
  var i; var j;
  i = 0;
  while (i < 10) {
    j = 0;
    while (j < 10) {
      if (i * 10 + j == t) { return i * 100 + j; }
      j = j + 1;
    }
    i = i + 1;
  }
  return -5;
}
func main() {
  var i;
  i = 0;
  while (i < 10) { a[i] = i * 3; i = i + 1; }
  pd(find(9)); pd(find(10)); pd(find(0)); pd(find(27));
  pd(firstsq(50)); pd(firstsq(0));
  pd(nested(47)); pd(nested(100));
}
