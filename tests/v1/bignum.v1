// Arbitrary-precision decimal numbers in fixed slots of a digit pool.
// Prints n! for n = 1..30, the sum 1! + ... + 30!, 100! with its digit
// sum, powers of two up to 2^256, and selected Fibonacci numbers.

var width;          // digits per slot
array dig[1600];    // 8 slots of 200 digits, least significant first
array blen[8];
var quot;
array p10[10];

func initp10() {
  var i;
  p10[0] = 1;
  i = 1;
  while (i < 10) {
    p10[i] = p10[i - 1] * 10;
    i = i + 1;
  }
  return 0;
}

func printint(x) {
  var i;
  var d;
  var started;
  if (x < 0) { putc(45); } else { x = -x; }
  started = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (x <= -p10[i]) {
      x = x + p10[i];
      d = d + 1;
    }
    if (d != 0) { started = 1; }
    if (i == 0) { started = 1; }
    if (started) { putc(48 + d); }
    i = i - 1;
  }
  return 0;
}

// quot = v / 10 for 0 <= v < 100000, returns v mod 10.
func divmod10(v) {
  quot = 0;
  while (v >= 10000) { v = v - 10000; quot = quot + 1000; }
  while (v >= 1000) { v = v - 1000; quot = quot + 100; }
  while (v >= 100) { v = v - 100; quot = quot + 10; }
  while (v >= 10) { v = v - 10; quot = quot + 1; }
  return v;
}

func setsmall(k, v) {
  var i;
  i = 0;
  while (i < width) {
    dig[k * width + i] = 0;
    i = i + 1;
  }
  blen[k] = 0;
  dig[k * width] = 0;
  if (v == 0) { blen[k] = 1; }
  while (v > 0) {
    dig[k * width + blen[k]] = divmod10(v);
    v = quot;
    blen[k] = blen[k] + 1;
  }
  return 0;
}

func copybig(dst, src) {
  var i;
  i = 0;
  while (i < blen[src]) {
    dig[dst * width + i] = dig[src * width + i];
    i = i + 1;
  }
  blen[dst] = blen[src];
  return 0;
}

// slot k = slot k * m, for 0 <= m <= 9999
func mulsmall(k, m) {
  var i;
  var carry;
  var base;
  base = k * width;
  carry = 0;
  i = 0;
  while (i < blen[k]) {
    dig[base + i] = divmod10(dig[base + i] * m + carry);
    carry = quot;
    i = i + 1;
  }
  while (carry > 0) {
    dig[base + blen[k]] = divmod10(carry);
    carry = quot;
    blen[k] = blen[k] + 1;
  }
  while (blen[k] > 1) {
    if (dig[base + blen[k] - 1] == 0) { blen[k] = blen[k] - 1; } else { return 0; }
  }
  return 0;
}

// slot dst = slot a + slot b (dst may equal a or b)
func addbig(dst, a, b) {
  var i;
  var n;
  var carry;
  var v;
  n = blen[a];
  if (blen[b] > n) { n = blen[b]; }
  carry = 0;
  i = 0;
  while (i < n) {
    v = carry;
    if (i < blen[a]) { v = v + dig[a * width + i]; }
    if (i < blen[b]) { v = v + dig[b * width + i]; }
    carry = 0;
    if (v >= 10) {
      v = v - 10;
      carry = 1;
    }
    dig[dst * width + i] = v;
    i = i + 1;
  }
  if (carry) {
    dig[dst * width + n] = 1;
    n = n + 1;
  }
  blen[dst] = n;
  return 0;
}

func printbig(k) {
  var i;
  i = blen[k] - 1;
  while (i >= 0) {
    putc(48 + dig[k * width + i]);
    i = i - 1;
  }
  return 0;
}

func digitsum(k) {
  var i;
  var s;
  s = 0;
  i = 0;
  while (i < blen[k]) {
    s = s + dig[k * width + i];
    i = i + 1;
  }
  return s;
}

func main() {
  var n;
  var t;
  initp10();
  width = 200;
  // factorials and their running sum
  setsmall(0, 1);
  setsmall(1, 0);
  n = 1;
  while (n <= 30) {
    mulsmall(0, n);
    addbig(1, 1, 0);
    printint(n); putc(33); putc(61);
    printbig(0); putc(10);
    n = n + 1;
  }
  putc(83); putc(61); printbig(1); putc(10);
  while (n <= 100) {
    mulsmall(0, n);
    n = n + 1;
  }
  printbig(0); putc(10);
  printint(blen[0]); putc(32); printint(digitsum(0)); putc(10);
  // powers of two, printed every 32 steps
  setsmall(2, 1);
  n = 1;
  while (n <= 256) {
    addbig(2, 2, 2);
    t = n;
    while (t > 0) { t = t - 32; }
    if (t == 0) {
      putc(50); putc(94); printint(n); putc(61); printbig(2); putc(10);
    }
    n = n + 1;
  }
  // Fibonacci: slot 3 = F(n), slot 4 = F(n+1)
  setsmall(3, 0);
  setsmall(4, 1);
  n = 0;
  while (n <= 300) {
    t = n;
    while (t > 0) { t = t - 50; }
    if (t == 0) {
      putc(70); printint(n); putc(61); printbig(3); putc(10);
    }
    addbig(5, 3, 4);
    copybig(3, 4);
    copybig(4, 5);
    n = n + 1;
  }
  // a product of mixed factors: 9999^20 * 7
  setsmall(6, 7);
  n = 0;
  while (n < 20) {
    mulsmall(6, 9999);
    n = n + 1;
  }
  printbig(6); putc(10);
  printint(digitsum(6)); putc(10);
}
