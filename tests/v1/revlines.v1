// Line reversal. Reads all input (lines end at byte 10; the last line may
// have no newline), then prints three sections:
//   R: each line with its bytes reversed,
//   L: the lines in reverse order,
//   W: each line with its space-separated words in reverse order.
// Ends with line count, total bytes and the longest line's length.

var cap;
array buf[20000];
var len;
array lstart[2000];
array llen[2000];
var nlines;
var hasfinalnl;
array p10[10];

func initp10() {
  var i;
  p10[0] = 1;
  i = 1;
  while (i < 10) {
    p10[i] = p10[i - 1] * 10;
    i = i + 1;
  }
  return 0;
}

func printint(x) {
  var i;
  var d;
  var started;
  if (x < 0) { putc(45); } else { x = -x; }
  started = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (x <= -p10[i]) {
      x = x + p10[i];
      d = d + 1;
    }
    if (d != 0) { started = 1; }
    if (i == 0) { started = 1; }
    if (started) { putc(48 + d); }
    i = i - 1;
  }
  return 0;
}

func readall() {
  var c;
  len = 0;
  c = getc();
  while (c != -1) {
    if (len < cap) {
      buf[len] = c;
      len = len + 1;
    }
    c = getc();
  }
  return 0;
}

func splitlines() {
  var i;
  var s;
  nlines = 0;
  hasfinalnl = 0;
  s = 0;
  i = 0;
  while (i < len) {
    if (buf[i] == 10) {
      lstart[nlines] = s;
      llen[nlines] = i - s;
      nlines = nlines + 1;
      s = i + 1;
    }
    i = i + 1;
  }
  if (s < len) {
    lstart[nlines] = s;
    llen[nlines] = len - s;
    nlines = nlines + 1;
  } else {
    if (len > 0) { hasfinalnl = 1; }
  }
  return 0;
}

func header(c) {
  putc(61); putc(c); putc(61); putc(10);
  return 0;
}

func putrange(s, n) {
  var k;
  k = 0;
  while (k < n) {
    putc(buf[s + k]);
    k = k + 1;
  }
  return 0;
}

func reversebytes() {
  var l;
  var k;
  l = 0;
  while (l < nlines) {
    k = llen[l] - 1;
    while (k >= 0) {
      putc(buf[lstart[l] + k]);
      k = k - 1;
    }
    putc(10);
    l = l + 1;
  }
  return 0;
}

func reverselines() {
  var l;
  l = nlines - 1;
  while (l >= 0) {
    putrange(lstart[l], llen[l]);
    putc(10);
    l = l - 1;
  }
  return 0;
}

// Moves e left past bytes that are spaces (want == 1) or non-spaces (want == 0).
func scanback(s, e, want) {
  var go;
  go = 1;
  while (go) {
    if (e > s) {
      if ((buf[e - 1] == 32) == want) { e = e - 1; } else { go = 0; }
    } else {
      go = 0;
    }
  }
  return e;
}

// Words are maximal runs of non-space bytes; runs of spaces collapse to one.
func reversewords() {
  var l;
  var s;
  var e;
  var b;
  var first;
  l = 0;
  while (l < nlines) {
    s = lstart[l];
    e = scanback(s, s + llen[l], 1);
    first = 1;
    while (e > s) {
      b = scanback(s, e, 0);
      if (first == 0) { putc(32); }
      first = 0;
      putrange(b, e - b);
      e = scanback(s, b, 1);
    }
    putc(10);
    l = l + 1;
  }
  return 0;
}

func main() {
  var l;
  var longest;
  initp10();
  cap = 20000;
  readall();
  splitlines();
  header(82);
  reversebytes();
  header(76);
  reverselines();
  header(87);
  reversewords();
  longest = 0;
  l = 0;
  while (l < nlines) {
    if (llen[l] > longest) { longest = llen[l]; }
    l = l + 1;
  }
  printint(nlines); putc(32); printint(len); putc(32);
  printint(longest); putc(32); printint(hasfinalnl); putc(10);
}
