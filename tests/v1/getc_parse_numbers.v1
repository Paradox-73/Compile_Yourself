array pw[10];
func pd(n) {
  var m; var i; var d; var s;
  if (n < 0) { putc(45); m = n; } else { m = 0 - n; }
  pw[0] = 1;
  i = 1;
  while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
  s = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (m <= 0 - pw[i]) { m = m + pw[i]; d = d + 1; }
    if (d != 0) { s = 1; }
    if (i == 0) { s = 1; }
    if (s) { putc(48 + d); }
    i = i - 1;
  }
  putc(10);
}
var c;
func readnum() {
  var neg; var v;
  neg = 0;
  v = 0;
  if (c == 45) { neg = 1; c = getc(); }
  while (c >= 48) { v = v * 10 + c - 48; c = getc(); }
  if (neg) { v = 0 - v; }
  return v;
}
func main() {
  var v; var tot;
  tot = 0;
  c = getc();
  while (c != -1) {
    v = readnum();
    pd(v * 2);
    tot = tot + v;
    c = getc();
  }
  pd(tot);
}
