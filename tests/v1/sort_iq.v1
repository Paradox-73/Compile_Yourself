// Reads signed decimal numbers (any non-digit bytes separate them) until
// end of input, sorts one copy with insertion sort and another with
// quicksort, checks both agree, and prints the sorted list with stats.

var maxn;
array a[1000];
array b[1000];
var n;
var look;
var gotnum;
var shifts;
array p10[10];

func initp10() {
  var i;
  p10[0] = 1;
  i = 1;
  while (i < 10) {
    p10[i] = p10[i - 1] * 10;
    i = i + 1;
  }
  return 0;
}

func printint(x) {
  var i;
  var d;
  var started;
  if (x < 0) { putc(45); } else { x = -x; }
  started = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (x <= -p10[i]) {
      x = x + p10[i];
      d = d + 1;
    }
    if (d != 0) { started = 1; }
    if (i == 0) { started = 1; }
    if (started) { putc(48 + d); }
    i = i - 1;
  }
  return 0;
}

func isdigit(c) {
  if (c >= 48) {
    if (c <= 57) { return 1; }
  }
  return 0;
}

// Returns the next number; sets gotnum to 0 when the input has ended.
func readnum() {
  var neg;
  var v;
  neg = 0;
  gotnum = 0;
  while (gotnum == 0) {
    if (look == -1) { return 0; }
    if (look == 45) {
      look = getc();
      if (isdigit(look)) {
        neg = 1;
        gotnum = 1;
      }
    } else {
      if (isdigit(look)) {
        gotnum = 1;
      } else {
        look = getc();
      }
    }
  }
  v = 0;
  while (isdigit(look)) {
    v = v * 10 + look - 48;
    look = getc();
  }
  if (neg) { v = -v; }
  return v;
}

func insertion() {
  var i;
  var j;
  var key;
  var moving;
  shifts = 0;
  i = 1;
  while (i < n) {
    key = a[i];
    j = i - 1;
    moving = 1;
    while (moving) {
      if (j < 0) {
        moving = 0;
      } else {
        if (a[j] > key) {
          a[j + 1] = a[j];
          shifts = shifts + 1;
          j = j - 1;
        } else {
          moving = 0;
        }
      }
    }
    a[j + 1] = key;
    i = i + 1;
  }
  return 0;
}

func swap(i, j) {
  var t;
  t = b[i];
  b[i] = b[j];
  b[j] = t;
  return 0;
}

// Lomuto partition with the middle element moved to the end as pivot.
func quick(lo, hi) {
  var mid;
  var pivot;
  var i;
  var j;
  if (lo >= hi) { return 0; }
  mid = lo;
  j = hi;
  while (mid < j) {
    mid = mid + 1;
    j = j - 1;
  }
  swap(mid, hi);
  pivot = b[hi];
  i = lo;
  j = lo;
  while (j < hi) {
    if (b[j] < pivot) {
      swap(i, j);
      i = i + 1;
    }
    j = j + 1;
  }
  swap(i, hi);
  quick(lo, i - 1);
  quick(i + 1, hi);
  return 0;
}

func main() {
  var x;
  var i;
  var ok;
  var distinct;
  var sum;
  initp10();
  maxn = 1000;
  n = 0;
  look = getc();
  x = readnum();
  while (gotnum) {
    if (n < maxn) {
      a[n] = x;
      b[n] = x;
      n = n + 1;
    }
    x = readnum();
  }
  insertion();
  quick(0, n - 1);
  ok = 1;
  distinct = 0;
  sum = 0;
  i = 0;
  while (i < n) {
    if (a[i] != b[i]) { ok = 0; }
    if (i == 0) {
      distinct = 1;
    } else {
      if (a[i] != a[i - 1]) { distinct = distinct + 1; }
      if (a[i] < a[i - 1]) { ok = 0; }
    }
    sum = sum + a[i];
    printint(a[i]);
    if (i == n - 1) {
      putc(10);
    } else {
      x = i + 1;
      while (x >= 8) { x = x - 8; }
      if (x == 0) { putc(10); } else { putc(32); }
    }
    i = i + 1;
  }
  putc(110); putc(61); printint(n); putc(10);
  putc(100); putc(61); printint(distinct); putc(10);
  putc(105); putc(61); printint(shifts); putc(10);
  putc(115); putc(61); printint(sum); putc(10);
  if (n > 0) {
    putc(109); putc(61); printint(a[0]); putc(32); printint(a[n - 1]); putc(10);
  }
  if (ok) { putc(79); putc(75); } else { putc(66); putc(65); putc(68); }
  putc(10);
}
