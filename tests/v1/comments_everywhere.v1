// leading comment
array pw[10];
func pd(n) {
  var m; var i; var d; var s;
  if (n < 0) { putc(45); m = n; } else { m = 0 - n; }
  pw[0] = 1;
  i = 1;
  while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
  s = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (m <= 0 - pw[i]) { m = m + pw[i]; d = d + 1; }
    if (d != 0) { s = 1; }
    if (i == 0) { s = 1; }
    if (s) { putc(48 + d); }
    i = i - 1;
  }
  putc(10);
}
var g; // after decl
// var notreal;
func f(a, // after param
       b) // after paren
{ // after brace
  return a // mid expression
    * b; // end
}
func main() { // x = 1;
  g = f(6, 7); //comment with // double slashes and symbols {}();
  pd(g);//no space
  //putc(88);
  putc(79); putc(75); // ok
  putc(10);
}
// final comment without newline