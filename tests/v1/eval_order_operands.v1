array pw[10];
func pd(n) {
  var m; var i; var d; var s;
  if (n < 0) { putc(45); m = n; } else { m = 0 - n; }
  pw[0] = 1;
  i = 1;
  while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
  s = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (m <= 0 - pw[i]) { m = m + pw[i]; d = d + 1; }
    if (d != 0) { s = 1; }
    if (i == 0) { s = 1; }
    if (s) { putc(48 + d); }
    i = i - 1;
  }
  putc(10);
}
func f(c) { putc(c); return c - 64; }
func main() {
  var r;
  r = f(65) + f(66) * f(67);
  putc(10); pd(r);
  r = f(65) * f(66) + f(67);
  putc(10); pd(r);
  r = f(68) - f(69) - f(70);
  putc(10); pd(r);
  r = f(65) < f(66);
  putc(10); pd(r);
  r = -f(71) * f(72);
  putc(10); pd(r);
  r = f(65) + (f(66) + f(67)) * f(68);
