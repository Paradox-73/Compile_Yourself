func cmp6(a, b) {
  putc(48 + (a < b)); putc(48 + (a <= b)); putc(48 + (a > b));
  putc(48 + (a >= b)); putc(48 + (a == b)); putc(48 + (a != b)); putc(10);
}
func main() {
  cmp6((2000000000), (-2000000000));
  cmp6((-2000000000), (2000000000));
  cmp6((2147483647), (-2147483647 - 1));
  cmp6((-2147483647 - 1), (2147483647));
  cmp6((-2147483647 - 1), (-2147483647 - 1));
  cmp6((2147483647), (2147483647));
  cmp6((-2147483647 - 1), (1));
  cmp6((1), (-2147483647 - 1));
  cmp6((2147483647), (-1));
  cmp6((-1), (2147483647));
  cmp6((-2147483647 - 1), (0));
  cmp6((0), (-2147483647 - 1));
  cmp6((2147483647), (-2147483647));
  cmp6((-2147483647), (2147483647));
  cmp6((2147483646), (2147483647));
  putc(48 + (2000000000 < -2000000000));
  putc(48 + (-2000000000 < 2000000000));
  putc(48 + (2147483647 > -2147483647 - 1));
  putc(48 + (-2147483647 - 1 >= 2147483647));
  putc(48 + (2147483647 <= -2));
  putc(48 + (-2147483647 - 1 < 2147483647));
  putc(10);
}
