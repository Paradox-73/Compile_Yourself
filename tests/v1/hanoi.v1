// Towers of Hanoi for n = 1..8. Prints each move as two peg letters
// (source then destination), simulates the pegs to check every move is
// legal, and prints a summary line per n.

array peg[30];     // peg[p*10 + k] = disk at height k on peg p
array height[3];
var moves;
var illegal;
array p10[10];

func initp10() {
  var i;
  p10[0] = 1;
  i = 1;
  while (i < 10) {
    p10[i] = p10[i - 1] * 10;
    i = i + 1;
  }
  return 0;
}

func printint(n) {
  var i;
  var d;
  var started;
  if (n < 0) { putc(45); } else { n = -n; }
  started = 0;
  i = 9;
  while (i >= 0) {
    d = 0;
    while (n <= -p10[i]) {
      n = n + p10[i];
      d = d + 1;
    }
    if (d != 0) { started = 1; }
    if (i == 0) { started = 1; }
    if (started) { putc(48 + d); }
    i = i - 1;
  }
  return 0;
}

func reset(n) {
  var k;
  height[0] = n;
  height[1] = 0;
  height[2] = 0;
  k = 0;
  while (k < n) {
    peg[k] = n - k;
    k = k + 1;
  }
  moves = 0;
  return 0;
}

func move(src, dst) {
  var disk;
  var top;
  putc(65 + src);
  putc(65 + dst);
  putc(10);
  moves = moves + 1;
  if (height[src] == 0) {
    illegal = illegal + 1;
  } else {
    disk = peg[src * 10 + height[src] - 1];
    if (height[dst] > 0) {
      top = peg[dst * 10 + height[dst] - 1];
      if (top < disk) { illegal = illegal + 1; }
    }
    height[src] = height[src] - 1;
    peg[dst * 10 + height[dst]] = disk;
    height[dst] = height[dst] + 1;
  }
  return 0;
}

func hanoi(n, src, dst, via) {
  if (n == 0) { return 0; }
  hanoi(n - 1, src, via, dst);
  move(src, dst);
  hanoi(n - 1, via, dst, src);
  return 0;
}

// 2 to the power n, by repeated doubling.
func pow2(n) {
  var r;
  r = 1;
  while (n > 0) {
    r = r + r;
    n = n - 1;
  }
  return r;
}

func main() {
  var n;
  var total;
  initp10();
  illegal = 0;
  total = 0;
  n = 1;
  while (n <= 8) {
    putc(110); putc(61); printint(n); putc(10);
    reset(n);
    hanoi(n, 0, 2, 1);
    total = total + moves;
    putc(35); printint(moves);
    if (height[2] == n) { putc(32); putc(111); putc(107); }
    if (moves != pow2(n) - 1) { putc(32); putc(33); }
    putc(10);
    n = n + 1;
  }
  printint(total); putc(32); printint(illegal); putc(10);
}
